<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TiaBridge.Core/TiaBridge.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <EmbeddedResource Include="Storage/Migrations/*.sql" />
    <InternalsVisibleTo Include="TiaBridge.Host.Tests" />
  </ItemGroup>
</Project>
