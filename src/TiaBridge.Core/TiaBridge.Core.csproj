<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Esprima" Version="3.0.6" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.3" />
    <EmbeddedResource Include="../../contracts/v1/*.schema.json" Link="Contracts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../contracts/v2/capability-registry.schema.json" LogicalName="TiaBridge.Core.Contracts.capability-registry-v2.schema.json" />
  </ItemGroup>
</Project>
