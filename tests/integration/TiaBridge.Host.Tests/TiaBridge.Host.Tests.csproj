<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../../src/TiaBridge.Host/TiaBridge.Host.csproj" />
    <ProjectReference Include="../../../src/TiaBridge.Qualification/TiaBridge.Qualification.csproj" />
    <ProjectReference Include="../TiaBridge.StorageProbe/TiaBridge.StorageProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TiaBridge.Ipc.FrameworkProbe/TiaBridge.Ipc.FrameworkProbe.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../TiaBridge.Worker.InfrastructureProbe/TiaBridge.Worker.InfrastructureProbe.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../../src/TiaBridge.FakeWorker/TiaBridge.FakeWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/TiaBridge.Cli/TiaBridge.Cli.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../../../examples/contracts/v1/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../examples/ipc/v1/*.json" Link="IpcFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../src/TiaBridge.Worker.V19/InventoryFamily.cs" Link="SyntheticInventory/InventoryFamily.cs" />
    <Compile Include="../../../src/TiaBridge.Worker.V19/HmiEventDiagnosticProjection.cs" Link="SyntheticInventory/HmiEventDiagnosticProjection.cs" />
    <Compile Include="../../../src/TiaBridge.Worker.V19/HmiEventDiagnosticReader.cs" Link="SyntheticInventory/HmiEventDiagnosticReader.cs" />
    <Compile Include="../../../src/TiaBridge.Worker.V19/VendorReader.cs" Link="SyntheticInventory/VendorReader.cs" />
    <Compile Include="../../../src/TiaBridge.Worker.V19/WorkerResourceTrace.cs" Link="SyntheticInventory/WorkerResourceTrace.cs" />
    <Compile Include="../../diagnostics/PssHandleSnapshot.cs" Link="Diagnostics/PssHandleSnapshot.cs" />
    <Compile Include="../TiaBridge.StorageProbe/InfrastructureInvestigation.cs" Link="Diagnostics/InfrastructureInvestigation.cs" />
  </ItemGroup>
</Project>
