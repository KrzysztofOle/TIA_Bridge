{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source package report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tia-bridge.preflight/1.0"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "scope": {
      "type": "object",
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      },
      "required": [
        "root",
        "manifest",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "manifest.schema",
              "manifest.files",
              "files.sha256",
              "files.encoding",
              "files.eol"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "status",
          "count"
        ],
        "additionalProperties": false
      },
      "prefixItems": [
        {
          "properties": {
            "id": {
              "const": "manifest.schema"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "manifest.files"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "files.sha256"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "files.encoding"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "files.eol"
            }
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "expected": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "actual": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "remedy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "code",
          "path",
          "expected",
          "actual",
          "remedy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "exit_code",
    "scope",
    "checks",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "issues": {
            "maxItems": 0
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "minimum": 1
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
