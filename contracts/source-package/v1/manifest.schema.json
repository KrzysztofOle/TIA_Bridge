{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source package manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tia-bridge.source-package/1.0"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "role": {
            "enum": [
              "source",
              "native",
              "auxiliary"
            ]
          },
          "type": {
            "enum": [
              "text",
              "binary"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "object",
            "properties": {
              "encoding": {
                "enum": [
                  "utf-8"
                ]
              },
              "bom": {
                "enum": [
                  "required",
                  "forbidden",
                  "optional"
                ]
              },
              "eol": {
                "enum": [
                  "crlf",
                  "lf",
                  "any"
                ]
              },
              "final_newline": {
                "enum": [
                  "required",
                  "forbidden",
                  "optional"
                ]
              }
            },
            "required": [
              "encoding",
              "bom",
              "eol",
              "final_newline"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "role",
          "type",
          "sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            "then": {
              "required": [
                "text"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "text"
                ]
              }
            }
          }
        ]
      }
    },
    "required_checks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  },
  "required": [
    "schema_version",
    "files",
    "required_checks"
  ],
  "additionalProperties": false
}
