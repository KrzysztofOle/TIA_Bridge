{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tia-bridge2:acceptance:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "state",
    "poll_after_ms",
    "status_url",
    "result_url",
    "accepted_at"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "QUEUED"
      ]
    },
    "poll_after_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "status_url": {
      "type": "string",
      "pattern": "^/v1/operations/[0-9a-fA-F-]+$"
    },
    "result_url": {
      "type": "string",
      "pattern": "^/v1/operations/[0-9a-fA-F-]+/result$"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
