{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workspace-manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "project_key": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "adapter_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "export_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "exchange_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "normalizer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "comparison_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "project_key",
    "adapter_id",
    "adapter_build",
    "capability_set_hash",
    "export_revision",
    "project",
    "inventory",
    "exchange_units",
    "coverage",
    "normalizer_version",
    "comparison_profile"
  ],
  "additionalProperties": false,
  "$defs": {
    "coverage": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "type": "string",
                "enum": [
                  "CONTENT",
                  "CONFIG",
                  "API",
                  "STRUCTURE",
                  "DEPENDENCIES",
                  "INVENTORY"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "COMPLETE",
                  "PARTIAL",
                  "UNSUPPORTED",
                  "UNKNOWN"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "dimension",
              "state",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "dimensions"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "original_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "family": {
          "type": "string",
          "enum": [
            "PLC",
            "HMI_UNIFIED",
            "HMI_CLASSIC"
          ]
        }
      },
      "required": [
        "device_id",
        "original_name",
        "family"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "parent_group_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "group_id",
        "device_id",
        "parent_group_id",
        "original_name"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "project_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "original_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "tia_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "project_key",
        "original_name",
        "tia_version",
        "devices",
        "groups"
      ],
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "original_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "public_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "public_id_validity_scope": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "device_id",
        "groups",
        "kind",
        "original_name",
        "public_id",
        "public_id_validity_scope",
        "identity_evidence"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "role": {
          "type": "string",
          "enum": [
            "SOURCE",
            "NATIVE",
            "METADATA"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "relative_path",
        "role",
        "format",
        "raw_sha256"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "unit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vendor_fields": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 10000
        }
      },
      "required": [
        "unit_id",
        "members",
        "files",
        "unit_sha256",
        "vendor_fields"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor_locator": {
          "$ref": "#/$defs/locator"
        },
        "status": {
          "type": "string",
          "enum": [
            "REPRESENTED",
            "UNSUPPORTED",
            "ERROR",
            "UNKNOWN"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "exchange_unit_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "file_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target_object_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "relation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "target_object_id",
              "relation"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "comparison_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisions": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "native_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "source_revision",
            "native_revision"
          ],
          "additionalProperties": false
        },
        "vendor_fields": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 10000
        }
      },
      "required": [
        "object_id",
        "kind",
        "language",
        "vendor_locator",
        "status",
        "reason",
        "exchange_unit_id",
        "file_paths",
        "dependencies",
        "coverage",
        "normalizer_version",
        "comparison_profile",
        "model_sha256",
        "revisions",
        "vendor_fields"
      ],
      "additionalProperties": false
    }
  }
}
